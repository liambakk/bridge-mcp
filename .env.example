# ── Data source ───────────────────────────────────────────────────────────────
# Option A (offline): serve from a local JSON export instead of the live API.
# Point this at an Airtable-shaped export ({"records": [{"id", "fields"}, ...]}).
# When set, AIRTABLE_API_KEY / AIRTABLE_BASE_ID below are optional.
# BRIDGE_DATA_FILE=founders.json
#
# Option B (live): leave BRIDGE_DATA_FILE blank and fill in the Airtable
# connection below.

# ── Airtable connection ───────────────────────────────────────────────────────
# Personal Access Token (PAT). Create one at https://airtable.com/create/tokens
# with the scopes:  data.records:read  and  schema.bases:read
# Grant it access to the base that holds The Bridge participants.
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The base ID. Open the base in your browser; the URL looks like
#   https://airtable.com/appXXXXXXXXXXXXXX/...
# The "appXXXXXXXXXXXXXX" part is the base ID.
# Pre-filled for The Bridge base.
AIRTABLE_BASE_ID=apprmplt8X7rOIY6Z

# The table name or table id holding participants.
# Pre-filled with The Bridge participants table id. Leave blank to use the
# first table in the base.
AIRTABLE_TABLE_NAME=tblktmVkEaIIKb00o

# Optional. Restrict to a specific Airtable view (e.g. only confirmed attendees).
# AIRTABLE_VIEW=Grid view

# ── Server behaviour ──────────────────────────────────────────────────────────
# How long (seconds) to cache Airtable records before re-fetching.
CACHE_TTL_SECONDS=300

# Optional bearer token. If set, every HTTP request must send
#   Authorization: Bearer <this value>
# Strongly recommended when hosting publicly, since participant data is personal.
# BRIDGE_MCP_TOKEN=choose-a-long-random-secret

# HTTP host/port used when running with --transport http.
HOST=0.0.0.0
PORT=8000
